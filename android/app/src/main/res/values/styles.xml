<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MiniAnyDesk.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <!-- Native dialog text, cursors and checkboxes need contrast on white. -->
        <item name="android:colorAccent">#007A50</item>
        <item name="android:colorControlActivated">#007A50</item>
        <item name="android:colorControlNormal">#506B5D</item>
        <item name="android:colorButtonNormal">#FFFFFF</item>
        <item name="android:colorControlHighlight">#24007A50</item>
        <item name="android:windowBackground">#F4FAF7</item>
        <item name="android:statusBarColor">#F4FAF7</item>
        <item name="android:navigationBarColor">#F4FAF7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">#123A2A</item>
        <item name="android:textColorSecondary">#506B5D</item>
        <item name="android:textColorHint">#506B5D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MiniAnyDesk" parent="Theme.MiniAnyDesk.Base" />
</resources>
